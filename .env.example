# ---------------------------------------------------------------------------
# Credentials (ai-auth)
# ---------------------------------------------------------------------------
# A run is paid for in one of four ways: a Claude subscription the user signs
# in to here, a `claude`/`codex` login already on this machine, a stored API
# key, or one of the keys below. Users pick in the provider panel; these are
# the deployment-wide fallback.

# Encrypts every stored credential, and signs the account cookie. REQUIRED as
# soon as the web app and the worker are separate processes on separate hosts:
# they must derive the same key or each reads the other's rows as unreadable,
# which surfaces as users being silently signed out. With this unset, a key is
# generated once beside the credential file.
DOCEOMENTER_SECRET_KEY=

# Where credentials are kept. Defaults to <DATA_ROOT>/../credentials.
CREDENTIALS_DIR=

# Optional: keep credentials in Postgres instead of a file. Needs `pg`
# installed and the ai-auth SCHEMA_SQL applied through your own migrations.
CREDENTIALS_DATABASE_URL=
CREDENTIALS_TABLE=ai_auth_credentials

# Whether a `claude` or `codex` login on the host may be used. Leave true for a
# single-operator install; set false for anything a stranger can open, or one
# visitor's run bills the operator's own plan.
ALLOW_LOCAL_CLI=true

# Anthropic. If unset and no credential is configured anywhere, the run uses
# the deterministic fixture client (test mode).
ANTHROPIC_API_KEY=

# Models — ids come from the ai-auth registry. Override only if you know what
# you are doing.
ANTHROPIC_MODEL_PRIMARY=claude-opus-5
ANTHROPIC_MODEL_FALLBACK=claude-sonnet-5

# OpenAI, for the OpenAI/Codex providers.
OPENAI_API_KEY=
OPENAI_MODEL_PRIMARY=gpt-5
OPENAI_MODEL_FALLBACK=gpt-5-mini

# Job queue.
REDIS_URL=redis://127.0.0.1:6379

# Storage. local | s3
STORAGE_DRIVER=local
S3_BUCKET=
S3_REGION=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# Package mirrors used by booted projects (egress allowlist in container mode).
NPM_REGISTRY=https://registry.npmjs.org
PIP_INDEX_URL=https://pypi.org/simple

# Resource caps.
MAX_REPO_MB=500
MAX_RUN_SECONDS=600

# Worker mode: in-process | container
# in-process runs the pipeline inside the worker (dev default).
# container spawns a Docker container per job (prod, requires docker daemon).
RUN_MODE=in-process

# Set to true only on a host with docker-in-docker properly configured.
ENABLE_DOCKER_IN_DOCKER=false

# Dev only. Public URL the web app exposes; the worker uses this to build
# fully-qualified asset URLs in artifacts.
PUBLIC_BASE_URL=http://localhost:3000

# Per-IP run quota for the public POST /api/runs endpoint.
RUN_RATE_LIMIT_PER_HOUR=3
